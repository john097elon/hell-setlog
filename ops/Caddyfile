{$APP_HOST} {
	encode zstd gzip

	@metrics path /metrics
	respond @metrics 404

	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	log {
		output stdout
		format json
	}
}
