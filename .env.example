# Local development defaults. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://hellsetlog:hellsetlog@db:5432/hellsetlog
CANONICAL_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=["localhost","127.0.0.1"]
RELEASE=development

STORAGE_BACKEND=s3
STORAGE_BUCKET=hellsetlog-development
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=http://object-storage:9000
STORAGE_ACCESS_KEY=local-development-only
STORAGE_SECRET_KEY=local-development-only
STORAGE_MAX_BYTES=10485760

# Required and secret-managed in staging/production.
SENTRY_DSN=
